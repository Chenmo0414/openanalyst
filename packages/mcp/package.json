{
  "name": "tukey-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Tukey: attach CSV/Parquet/JSON/XLSX, auto-profile, run read-only SQL, and render charts — for Claude Code, Codex, Cursor and any MCP client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tukey-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "data-analysis",
    "duckdb",
    "vega-lite",
    "claude-code",
    "deepseek-harness"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tukey/core": "workspace:^",
    "zod": "^3.24.0",
    "@tukey/report": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chenmo0414/tukey.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Chenmo0414/tukey",
  "bugs": {
    "url": "https://github.com/Chenmo0414/tukey/issues"
  },
  "author": "Chenmo0414",
  "publishConfig": {
    "access": "public"
  }
}
